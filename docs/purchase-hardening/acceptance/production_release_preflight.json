    {
      "signature": "fn_contract_cancel_holds(text,text,text)",
      "body_md5": "3cb2c8d99d8d70e2a3e188ac70e4be7f",
      "definition": "CREATE OR REPLACE FUNCTION public.fn_contract_cancel_holds(p_contract_id text, p_member_id text, p_why text)\n RETURNS integer\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare\n  v_n  int;\n  v_op text := coalesce(current_employee_id(), '系統／直連');\nbegin\n  if p_contract_id is null then return 0; end if;\n  update bookings\n     set status = 'cancelled',\n         cancelled_at = now(),\n         cancelled_by = case when current_employee_id() is not null then current_employee_id() else cancelled_by end,\n         cancel_reason = p_why || '｜操作者 ' || v_op\n   where contract_id = p_contract_id\n     and pending_contract is true and ticket_id is null          -- 已轉正（有票）的永遠不碰\n     and status::text <> 'cancelled'\n     and member_id is not distinct from p_member_id;\n  get diagnostics v_n = row_count;\n  return v_n;\nend\n$function$\n",
      "acl": "{postgres=X/postgres}",
      "security_definer": true,
      "config": [
        "search_path=public, pg_temp"
      ]
    },
    {
      "signature": "fn_contracts_delete_cascade()",
      "body_md5": "2538c38e14e2158afd030166a50ccf04",
      "definition": "CREATE OR REPLACE FUNCTION public.fn_contracts_delete_cascade()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare\n  v_n int;\nbegin\n  perform 1 from ticket_grant_requests r where r.contract_id = old.id for update;      -- 鎖序：申請列先\n  v_n := public.fn_contract_cancel_holds(old.id, old.member_id,\n           '合約刪除連動（合約 ' || old.id || '）自動取消未轉正卡位');\n  update ticket_grant_requests\n     set status = 'cancelled',\n         cancel_reason = coalesce(nullif(cancel_reason, ''), '合約被刪除'),\n         reviewed_at = coalesce(reviewed_at, now())\n   where contract_id = old.id and status = 'pending';                                  -- 觸發 trg_tgr_cancel_cascade（此時已無卡位可取消）\n  return old;\nend\n$function$\n",
      "acl": "{postgres=X/postgres}",
      "security_definer": true,
      "config": [
        "search_path=public, pg_temp"
      ]
    },
    {
      "signature": "fn_log_change()",
      "body_md5": "bb62d34e3fbf5fcc9305d0421ff3ede8",
      "definition": "CREATE OR REPLACE FUNCTION public.fn_log_change()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\nbegin\n  insert into public.change_log(tbl,row_id,op)\n  values (tg_table_name,\n          coalesce((case when tg_op='DELETE' then old.id else new.id end), '')::text,\n          left(tg_op,1));\n  return null;   -- AFTER trigger，回傳值不影響原本的寫入\nend $function$\n",
      "acl": "{postgres=X/postgres}",
      "security_definer": true,
      "config": [
        "search_path=public, pg_temp"
      ]
    },
    {
      "signature": "fn_member_sign_installment(text,integer,text)",
      "body_md5": "8cc549573ff226306c138e85ad3f2950",
      "definition": "CREATE OR REPLACE FUNCTION public.fn_member_sign_installment(p_contract_id text, p_n integer, p_signature text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare\n  c contracts%rowtype;\n  arr jsonb;\n  idx int;\n  hit jsonb;\nbegin\n  select * into c from contracts where id=p_contract_id for update;\n  if not found then return jsonb_build_object('ok',false,'error_code','CONTRACT.NOT_FOUND'); end if;\n  if current_member_id() is null or c.member_id <> current_member_id() then\n    return jsonb_build_object('ok',false,'error_code','AUTH.FORBIDDEN');\n  end if;\n  if p_signature is null or length(p_signature) < 200 then\n    return jsonb_build_object('ok',false,'error_code','SIGNATURE.INVALID');\n  end if;\n\n  arr := coalesce(c.installment_signs,'[]'::jsonb);\n  select i, e into idx, hit\n    from jsonb_array_elements(arr) with ordinality t(e,ord), lateral (select ord-1) s(i)\n   where (e->>'n')::int = p_n\n   limit 1;\n\n  if hit is null then return jsonb_build_object('ok',false,'error_code','INSTALLMENT.NOT_PENDING'); end if;\n  if (hit->>'signature') is not null then return jsonb_build_object('ok',true,'already',true); end if;\n  if coalesce(hit->>'sign_type','remote') <> 'remote' then\n    return jsonb_build_object('ok',false,'error_code','INSTALLMENT.NOT_REMOTE');\n  end if;\n\n  arr := jsonb_set(arr, array[idx::text],\n           hit || jsonb_build_object('signature',p_signature,'signed_at',to_jsonb(now())));\n  update contracts\n     set installment_signs=arr,\n         pending_sign_n  = case when pending_sign_n = p_n then null else pending_sign_n end,\n         pending_sign_at = case when pending_sign_n = p_n then null else pending_sign_at end\n   where id=c.id;\n  return jsonb_build_object('ok',true,'contract_id',c.id,'n',p_n);\nexception when others then\n  return jsonb_build_object('ok',false,'error_code',sqlerrm);\nend $function$\n",
      "acl": "{postgres=X/postgres,authenticated=X/postgres}",
      "security_definer": true,
      "config": [
        "search_path=public, pg_temp"
      ]
    },
    {
      "signature": "fn_tk_holding(text,text)",
      "body_md5": "9b7f69b681bab1c00970b75603f3e172",
      "definition": "CREATE OR REPLACE FUNCTION public.fn_tk_holding(p_ticket text, p_exclude text DEFAULT NULL::text)\n RETURNS TABLE(booking_id text, bdate date, bstatus text)\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\n  select b.id, b.date, b.status::text\n    from bookings b\n   where b.status::text is distinct from 'cancelled'\n     and b.id is distinct from p_exclude\n     and ( b.ticket_id = p_ticket\n           or b.id in ( select l.booking_id from ticket_logs l\n                         where l.ticket_id = p_ticket and l.booking_id is not null\n                         group by l.booking_id\n                        having coalesce(sum(case when l.action::text = 'deduct' then 1\n                                                 when l.action::text = 'refund' then -1 else 0 end), 0) > 0 ) )\n$function$\n",
      "acl": "{postgres=X/postgres}",
      "security_definer": true,
      "config": [
        "search_path=public, pg_temp"
      ]
    },
    {
      "signature": "fn_tk_is_unopened(member_tickets)",
      "body_md5": "29e5d64eb14b383ce183ecf493334608",
      "definition": "CREATE OR REPLACE FUNCTION public.fn_tk_is_unopened(t member_tickets)\n RETURNS boolean\n LANGUAGE sql\n IMMUTABLE\n SET search_path TO 'public', 'pg_temp'\nAS $function$ select coalesce(t.valid_days, 0) > 0 and t.activated_at is null and t.start_date is null and t.expire_date is null $function$\n",
      "acl": "{postgres=X/postgres}",
      "security_definer": false,
      "config": [
        "search_path=public, pg_temp"
      ]
    },
    {
      "signature": "fn_tk_today()",
      "body_md5": "40c8662d82e8223f8442b69e29a92e86",
      "definition": "CREATE OR REPLACE FUNCTION public.fn_tk_today()\n RETURNS date\n LANGUAGE sql\n STABLE\n SET search_path TO 'public', 'pg_temp'\nAS $function$ select (now() at time zone 'Asia/Taipei')::date $function$\n",
      "acl": "{postgres=X/postgres}",
      "security_definer": false,
      "config": [
        "search_path=public, pg_temp"
      ]
    },
    {
      "signature": "fn_tk_window_check(text)",
      "body_md5": "7be7c526a1e1908471ef255f128851f1",
      "definition": "CREATE OR REPLACE FUNCTION public.fn_tk_window_check(p_ticket text)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare t member_tickets%rowtype; v_min date; v_max date;\nbegin\n  if p_ticket is null then return; end if;\n  select * into t from member_tickets where id = p_ticket;\n  if not found or not public.fn_tk_is_unopened(t) then return; end if;\n  select * into t from member_tickets where id = p_ticket for update;      -- 之後的查詢是新快照，看得到對方已提交的預約\n  if not found or not public.fn_tk_is_unopened(t) then return; end if;\n  select min(h.bdate), max(h.bdate) into v_min, v_max from public.fn_tk_holding(p_ticket, null) h;\n  if v_min is null then return; end if;\n  if (v_max - v_min) > (t.valid_days - 1) then\n    raise exception 'TKWIN.OUT_OF_WINDOW:%:%', to_char(v_min, 'YYYY-MM-DD'), to_char(v_min + (t.valid_days - 1), 'YYYY-MM-DD')\n      using errcode = 'P0001',\n            hint = '尚未啟用的票券，預約日期需落在最早一堂起 ' || t.valid_days || ' 天內（至 ' || to_char(v_min + (t.valid_days - 1), 'YYYY/MM/DD') || '）；首次簽到後才正式起算效期';\n  end if;\nend\n$function$\n",
      "acl": "{postgres=X/postgres}",
      "security_definer": true,
      "config": [
        "search_path=public, pg_temp"
      ]
    },
    {
      "signature": "is_any_staff()",
      "body_md5": "f2bf84a74a15a0ee806eca816891aa16",
      "definition": "CREATE OR REPLACE FUNCTION public.is_any_staff()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$ select current_staff_role() is not null; $function$\n",
