    {
      "signature": "is_staff_desk()",
      "body_md5": "4843a4de4f5b8e68d141c48215596234",
      "definition": "CREATE OR REPLACE FUNCTION public.is_staff_desk()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$ select current_staff_role() in ('admin','front_desk')\n   or exists(select 1 from employees e where e.auth_id=auth.uid()\n       and e.role='coach' and coalesce(e.is_manager,false) and e.status is distinct from 'inactive'); $function$\n",
      "acl": null,
      "security_definer": true,
      "config": [
        "search_path=public, pg_temp"
      ]
    },
    {
      "signature": "trg_tk_quota_guard()",
      "body_md5": "999c8ef061cf126c068f9ecd4405590d",
      "definition": "CREATE OR REPLACE FUNCTION public.trg_tk_quota_guard()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare v_used_new integer; v_used_old integer;\nbegin\n  if new.unlocked_sessions is null or coalesce(new.sessions_total, 0) <= 0 then return new; end if;\n  if new.unlocked_sessions >= new.sessions_total then return new; end if;          -- 完整開通：沒有額度概念\n  v_used_new := new.sessions_total - coalesce(new.sessions_remaining, 0);\n  v_used_old := coalesce(old.sessions_total, new.sessions_total) - coalesce(old.sessions_remaining, 0);\n  if v_used_new > v_used_old and v_used_new > new.unlocked_sessions then\n    raise exception 'TICKET.INSTALLMENT_LOCKED'\n      using errcode = 'P0001',\n            detail = format('used=%s unlocked=%s', v_used_new, new.unlocked_sessions),\n            hint = '分期票只能使用已開通的堂數；請先完成下一期付款開通，再預約或扣課';\n  end if;\n  return new;\nend\n$function$\n",
      "acl": "{postgres=X/postgres}",
      "security_definer": true,
      "config": [
        "search_path=public, pg_temp"
      ]
    },
    {
      "signature": "trg_tk_window_ledger()",
      "body_md5": "62fd4c6165e953750341283644f7fbf5",
      "definition": "CREATE OR REPLACE FUNCTION public.trg_tk_window_ledger()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$ begin perform public.fn_tk_window_check(new.ticket_id); return null; end $function$\n",
      "acl": "{postgres=X/postgres}",
